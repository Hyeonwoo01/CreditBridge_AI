APP_ENV=local
DATABASE_URL=postgresql+psycopg://creditbridge:change-me@localhost:5432/creditbridge
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=creditbridge-documents
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-please
# 운영 S3는 AES256 또는 aws:kms. KMS가 없는 로컬 저장소(SeaweedFS)는 비워 둔다.
S3_SERVER_SIDE_ENCRYPTION=
# 분석에 쓸 AI: anthropic(Claude) 또는 openai(GPT)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 착수 시점에 쓸 Claude 모델 ID (코드에 하드코딩하지 않는다)
CLAUDE_MODEL=claude-opus-5-5
# 정책 거절 시 서버 측 대체 모델 사용 (Claude API 전용, Bedrock·Vertex·프록시면 false)
CLAUDE_SERVER_FALLBACK=true
# GPT를 쓰려면 LLM_PROVIDER=openai와 아래 두 값 (모델 ID도 코드에 하드코딩하지 않는다)
OPENAI_API_KEY=
OPENAI_MODEL=
# 추론 모델이 아니라 reasoning_effort를 받지 않는 GPT면 false
OPENAI_REASONING_EFFORT=true
# 임베딩 설정은 파일럿에서 추가
SESSION_SECRET=change-me
# 개인정보 삭제 요청 처리 기한(일)
PRIVACY_DELETION_DAYS=30
# 기한 알림: 매일 보내는 시각(UTC 0~23, 13 = 미국 동부 오전 9시)과 기준 일수
REMINDER_HOUR_UTC=13
REMINDER_PRIVACY_DAYS=3
REMINDER_MATERIAL_DAYS=3
REMINDER_UNASSIGNED_DAYS=2
# 알림 메일 (비우면 화면 알림만)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@creditbridge.local
APP_BASE_URL=http://localhost:8000
# 브라우저 웹 푸시 (비우면 끔). 만들기: uv run python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@creditbridge.local
