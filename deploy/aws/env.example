# AWS 배포용 설정 (docker-compose.prod.yml). EC2의 저장소 폴더에서: cp deploy/aws/env.example .env 후 값을 채운다.
# 이 파일(.env)은 git에 올리지 않는다. 절차: docs/deploy-aws.md

# 사이트 주소 (https 인증서를 받을 도메인. 이 EC2의 공인 IP를 가리켜야 한다)
SITE_DOMAIN=creditbridge.duckdns.org
# 메일 속 링크의 기준 주소 (https://SITE_DOMAIN)
APP_BASE_URL=https://creditbridge.duckdns.org

# RDS PostgreSQL 17: 엔드포인트·마스터 비밀번호. RDS는 SSL 연결만 받으므로 sslmode=require를 붙인다
# 비밀번호에 @ : / ? # % 가 있으면 URL 인코딩해야 한다 (영문·숫자로 만들면 편하다)
DATABASE_URL=postgresql+psycopg://creditbridge:<비밀번호>@<RDS 엔드포인트>:5432/creditbridge?sslmode=require

# S3: 버킷 이름과 리전(버킷을 만든 리전, 예: 서울 ap-northeast-2 · 시드니 ap-southeast-2). 접근 키는 비워 둔다 (EC2에 붙인 IAM 역할로 접속)
S3_BUCKET=<버킷 이름>
S3_REGION=ap-northeast-2
S3_SERVER_SIDE_ENCRYPTION=AES256

# 분석에 쓸 AI: anthropic(Claude) 또는 openai(GPT). 고른 쪽의 키·모델만 채우면 된다
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_SERVER_FALLBACK=true
# GPT를 쓰려면 LLM_PROVIDER=openai와 아래 두 값 (모델 ID도 코드에 하드코딩하지 않는다)
OPENAI_API_KEY=
OPENAI_MODEL=
# 추론 모델이 아니라 reasoning_effort를 받지 않는 GPT면 false
OPENAI_REASONING_EFFORT=true

# 로그인 세션 서명 키: 길고 무작위인 값. 한 번 정하면 바꾸지 않는다
# 만들기: openssl rand -hex 32
SESSION_SECRET=

# 기한 알림: 매일 보내는 시각(UTC 0~23)
REMINDER_HOUR_UTC=0

# 알림 메일 (비우면 화면 알림만, 비밀번호는 관리자가 임시 비밀번호로 초기화)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 브라우저 웹 푸시 (비우면 끔). 만들기: docker compose -f docker-compose.prod.yml run --rm web uv run --no-group dev python -m scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
